IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=11
BROKER_KIND=auto
IBKR_CONNECT_TIMEOUT_SECONDS=10
IBKR_REQUEST_TIMEOUT_SECONDS=10

# For paper-order-smoke only, set IBKR_CLIENT_ID=21 and MAX_TRADE_NOTIONAL=1000.
# Keep ALLOW_PAPER_ORDERS=false outside the exact gated smoke window.

TRADING_MODE=paper
ALLOW_PAPER_ORDERS=false
ALLOW_LIVE_ORDERS=false

MAX_TRADE_NOTIONAL=50
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=25
MAX_POSITION_PCT_EQUITY=2

UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA
